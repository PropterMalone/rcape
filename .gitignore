node_modules/
dist/
.env
# `.env` alone does not cover the copies an edit leaves behind (.env.bak,
# .env.2026-09-20, .env.save). Those hold the same live secrets, so they are
# ignored by pattern rather than by whoever remembers to delete them.
.env.*
!.env.example
*.car
data/
pds/data/
pds/pds.env
# Same gap as `.env` above, and this one holds the PDS SUPER-ADMIN password:
# `.env.*` has no slash so it matches basenames beginning `.env.`, which
# `pds.env.bak` does not. Needs its own pattern.
pds/pds.env.*
*.log
.DS_Store

# local Claude Code settings
.claude/
